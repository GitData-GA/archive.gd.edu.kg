{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "patternProperties": {
    "^\\d{14}/v\\d+$": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "license": { "type": "string" },
        "doi": { "type": "string" },
        "predecessor": { "type": ["string", "null"] },
        "successor": { "type": ["string", "null"] },
        "submissionDate": { 
          "type": "string", 
          "pattern": "^\\d{4}/\\d{2}/\\d{2}$" 
        },
        "keywords": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        },
        "author": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "firstName": { "type": "string" },
              "middleName": { "type": "string" },
              "lastName": { "type": "string" },
              "orcid": { "type": "string" }
            },
            "required": ["firstName", "lastName"],
            "additionalProperties": false
          }
        },
        "abstract": { "type": "string" },
        "submitterID": { "type": "string" },
        "relatedPublishment": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string" }
          },
          "required": ["name", "url"],
          "additionalProperties": false
        },
        "relatedLink": { "type": "string" },
        "comment": { "type": "string" }
      },
      "required": [
        "title", "subject", "license", "predecessor", "successor", 
        "submissionDate", "keywords", "author", "abstract", "submitterID"
      ]
    }
  },
  "additionalProperties": false
}
